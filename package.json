{
  "name": "dsh-v-explorer",
  "description": "V 文件探索器 — DeepSeek Harness Web 官方右侧栏扩展插件（增强文件树 tab：右键菜单/书签★/变更流自动刷新 · 书签 tab · Markdown Reader Pro 与 JSON 美化预览渲染器 · 行区间引用摘录；最低 DSH 0.1.5-rc.2）",
  "version": "0.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor10035445/dsh-v-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/victor10035445/dsh-v-explorer/issues"
  },
  "homepage": "https://github.com/victor10035445/dsh-v-explorer#readme",
  "keywords": [
    "dsh",
    "deepseek-harness-web",
    "file-explorer",
    "bookmarks",
    "markdown-preview"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/ref-shared.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node check-externals.mjs",
    "check:externals": "node check-externals.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "markdown-it": "^14.1.0"
  }
}
